<Project>
  <!--
    Configuración común de todos los proyectos. MSBuild (Microsoft.Common.props) busca hacia arriba desde cada
    proyecto e importa el Directory.Build.props más cercano antes del cuerpo del proyecto, así que cada proyecto
    puede sobrescribir estos valores. src/ y tests/ tienen el suyo, que importa este.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Calidad: analizadores recomendados de .NET y advertencias como errores. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Auditoría de NuGet (dependencias directas y transitivas): las vulnerabilidades bajas y moderadas se ven como
      advertencia; las altas y críticas (NU1903, NU1904) son errores, así que no se compila ni se publica con ellas.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>

    <!-- Solo los proyectos de src/ generan paquetes NuGet. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
