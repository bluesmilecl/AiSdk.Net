<Project>
  <!--
    Configuración común de todos los proyectos. MSBuild (Microsoft.Common.props) busca hacia arriba desde cada
    proyecto e importa el Directory.Build.props más cercano antes del cuerpo del proyecto, así que cada proyecto
    puede sobrescribir estos valores. src/ y tests/ tienen el suyo, que importa este.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Calidad: analizadores recomendados de .NET y advertencias como errores. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Las alertas de vulnerabilidades de NuGet se ven en la compilación, pero no la bloquean. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Solo los proyectos de src/ generan paquetes NuGet. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
