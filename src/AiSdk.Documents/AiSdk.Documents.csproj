<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Lee y genera documentos para la IA: PDF, Word, Excel, PowerPoint, HTML, imágenes, audio y video a Markdown con OCR; y Markdown/datos a Word, PDF y Excel con herramientas para agentes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AiSdk/AiSdk.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <EmbeddedResource Include="Fonts/*.ttf" LogicalName="AiSdk.Documents.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts/OFL.txt" Pack="true" PackagePath="licenses/fonts-OFL.txt" />
  </ItemGroup>
</Project>
