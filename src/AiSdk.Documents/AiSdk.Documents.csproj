<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Convierte PDF, Word, Excel, PowerPoint, HTML, imágenes, audio y video a Markdown para el contexto de la IA, con OCR (Tesseract, modelos con visión o Mistral OCR) y middleware para modelos sin visión.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AiSdk/AiSdk.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>
</Project>
