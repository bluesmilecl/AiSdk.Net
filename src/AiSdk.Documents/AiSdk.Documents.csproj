<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Read and generate documents for AI: PDF, Word, Excel, PowerPoint, HTML, images, audio and video to Markdown with OCR; and Markdown or data to Word, PDF and Excel, with agent tools.</Description>
    <!-- Mensajes localizados: el formato sale de Resources/Strings según CurrentUICulture en cada llamada; un
         CompositeFormat en caché fijaría el idioma del primer uso. -->
    <NoWarn>$(NoWarn);CA1863</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AiSdk/AiSdk.csproj" />
    <!-- Parser HTML (ya llegaba por ReverseMarkdown): se fija porque el convertidor HTML lo usa directamente. -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="Markdig" />
    <EmbeddedResource Include="Fonts/*.ttf" LogicalName="AiSdk.Documents.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts/OFL.txt" Pack="true" PackagePath="licenses/fonts-OFL.txt" />
  </ItemGroup>
</Project>
