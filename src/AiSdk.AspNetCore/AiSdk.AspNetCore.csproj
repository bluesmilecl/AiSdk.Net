<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>ASP.NET Core integration for AiSdk.Net: SSE streaming compatible with AI SDK UI useChat, plus artifacts, workflows (events, approvals, webhooks) and skills endpoints.</Description>
    <!-- Los formatos de los mensajes salen de recursos localizados (cambian con CurrentUICulture): un CompositeFormat cacheado fijaría el idioma. -->
    <NoWarn>$(NoWarn);CA1863</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../AiSdk/AiSdk.csproj" />
    <ProjectReference Include="../AiSdk.Workflows/AiSdk.Workflows.csproj" />
  </ItemGroup>
</Project>
