<Project>
  <!-- MSBuild solo importa automáticamente el Directory.Build.props más cercano: se encadena el de la raíz. -->
  <PropertyGroup>
    <ParentDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentDirectoryBuildProps>
  </PropertyGroup>
  <Import Project="$(ParentDirectoryBuildProps)" Condition="Exists('$(ParentDirectoryBuildProps)')" />

  <!-- Librerías publicadas en NuGet. El id es AiSdk.Net.* (el id "AiSdk" ya existe en nuget.org); los namespaces siguen siendo AiSdk.* -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AiSdk.Net$(MSBuildProjectName.Substring(5))</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bluesmile, Esteban Cortes</Authors>
    <Copyright>Copyright © Bluesmile (@bluesmilecl) and Esteban Cortes (@ecr17dev)</Copyright>
    <Description>AiSdk.Net: the open-source AI and agents SDK for .NET 10. Text, streaming, typed objects, tools, agents, multi-agent orchestration, RAG, Skills, durable workflows and MCP with OpenAI, Claude, Gemini, Mistral, Bedrock and Cohere.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;llm;agents;openai;anthropic;claude;gemini;mistral;rag;mcp;skills;workflows;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/bluesmilecl/AiSdk.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bluesmilecl/AiSdk.Net</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Mensajes en inglés por defecto (recursos neutrales) y en español con CurrentUICulture "es*" (ensamblado satélite). -->
    <NeutralLanguage>en</NeutralLanguage>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- La documentación XML es obligatoria en la API pública nueva, pero no se exige en cada miembro existente. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Paquetes reproducibles con símbolos y Source Link. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- README sin SVG ni rutas relativas: nuget.org no los muestra. El README visual está en la raíz del repositorio. -->
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget/README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../docs/assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
